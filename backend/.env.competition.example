# Copy to .env.competition (gitignored) for local Docker competition runs.
# Never commit real keys. Do not use build-args for HACKATHON_API_KEY.

COMPOSE_PROJECT_NAME=kontur_competition

# Host directory with subdirs: csv/ pdf/ ocr/ qa/ (mounted read-only at /inputs)
COMPETITION_INPUTS_DIR=./data/competition_docker_smoke/inputs

# Space-separated competition U_* present in the CSV catalog
COMPETITION_EXTERNAL_UIDS=U_900001 U_900002

# Persistent volume name (change for smoke vs full)
COMPETITION_STAND_VOLUME=kontur_competition_stand_data

# React web не входит в mobile-пакет; клиент — Flutter.
COMPETITION_API_HOST_PORT=8019

# Optional live turns only — omit for offline smoke
# HACKATHON_API_KEY=

COMPETITION_SECRET_KEY=competition-docker-local-secret
