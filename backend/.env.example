APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./kontur.db
# DATABASE_URL=postgresql+psycopg2://kontur:kontur@localhost:5432/kontur
# News / user-link bot (subscriptions + news outbox)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KonturDemoBot
TELEGRAM_WEBHOOK_SECRET=kontur-webhook-secret
# Optional second bot for support escalation / operator replies
# TELEGRAM_SUPPORT_BOT_TOKEN=
# TELEGRAM_SUPPORT_BOT_USERNAME=
# TELEGRAM_SUPPORT_WEBHOOK_SECRET=
# TELEGRAM_TEST_SEND_COOLDOWN_SECONDS=60
# Comma-separated outbox kinds for worker (empty = all). TG-3 stand uses: test
# TELEGRAM_OUTBOX_KINDS=test
# TG-4 automatic risk+impact news → outbox (default off). Do not enable on live stands
# until a controlled check. Stands keep TELEGRAM_OUTBOX_KINDS=test so news is not sent.
# TELEGRAM_NEWS_NOTIFICATIONS_ENABLED=false
# Dev getUpdates polling (mutually exclusive with webhook). No public ports.
# TELEGRAM_POLLING_STATE_DIR=data/telegram_live
# TELEGRAM_POLLING_TIMEOUT_SECONDS=25
CORS_ORIGINS=*
DEEP_LINK_BASE=https://kontur.app/e
# Public https origin for Telegram buttons (not localhost):
# PUBLIC_WEB_BASE_URL=https://example.com

# Assistant: mock | openai | gigachat | hackathon
# Deprecated alias: live → openai
ASSISTANT_PROVIDER=mock

# OpenAI (ASSISTANT_PROVIDER=openai) — server only, never put in web/.env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Legacy aliases still accepted
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini

# GigaChat (ASSISTANT_PROVIDER=gigachat) — server only
# Paste authorization key from GigaChat Studio (Basic credentials), not into frontend
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Optional overrides:
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_CA_BUNDLE=app/certs/gigachat_ca_bundle.pem

# Hackathon organizers gateway (ASSISTANT_PROVIDER=hackathon) — server only
# OpenAI-compatible chat.completions at HACKATHON_BASE_URL. Never put key in web/.env.
HACKATHON_API_KEY=
HACKATHON_BASE_URL=https://changellenge.up.railway.app/v1
HACKATHON_MODEL=deepseek/deepseek-v4.1-flash
# Optional when VPS cannot reach organizers' gateway directly (sidecar SOCKS / local relay):
# HACKATHON_SOCKS_PROXY=socks5://aspect-hackathon-egress:1080
# HACKATHON_EGRESS_PORT=9443
# Allowed models (exact IDs): google/gemma-4-26b-a4b-it | z-ai/glm-5.3-flash |
# qwen/qwen3.6-35b-a3b | deepseek/deepseek-v4.1-flash |
# qwen/qwen3-vl-30b-a3b-instruct | moonshotai/kimi-k2.6

# Competition profile (default off). When true: only hackathon provider + allow-list
# model + exact organizers base URL; OpenAI/GigaChat/mock and live enrich are refused
# before model HTTP. Do not enable in root .env unless deliberately judging a competition stand.
# COMPETITION_MODE=false

# Multi-step assistant loop (stage 4.2 protocol/budget). Default off — not wired to
# post_message yet. Do not enable in root .env until runtime integration (later stage).
# ASSISTANT_AGENT_LOOP=false
# ASSISTANT_LOOP_MAX_MODEL_HTTP=4
# ASSISTANT_LOOP_MAX_TOOL_CALLS=3
# ASSISTANT_LOOP_MAX_REPAIRS=1
# ASSISTANT_LOOP_TIMEOUT_S=90
# ASSISTANT_LOOP_MAX_RESULT_CHARS=4000
# ASSISTANT_LOOP_MAX_TRANSCRIPT_CHARS=12000
# ASSISTANT_LOOP_MAX_RAW_ACTION_CHARS=24000

# Ingestion — cron: python -m app.jobs.ingest_news
# Managed scheduler (separate process): python -m app.workers.news_scheduler
# Manual demo refresh: POST /api/v1/internal/ingestion/run with X-Ingestion-Token
INGESTION_RUN_TOKEN=
# Whitelist RSS feeds (pipe- or comma-separated). CBR news RSS is owned by CbrProvider —
# do not list https://www.cbr.ru/rss/RssNews here (pipeline skips it if present).
# EC presscorner URL may include dossier=trade; that param does NOT filter topics — not a trade feed.
INGESTION_RSS_FEEDS=https://www.interfax.ru/rss.asp|https://www.wto.org/library/rss/latest_news_e.xml|https://customs.gov.ru/press/federal/rss|https://ec.europa.eu/commission/presscorner/api/rss?dossier=trade&language=en|https://www.vedomosti.ru/rss/news
INGESTION_GDELT_QUERIES=export control OR sanctions OR supply chain|ключевая ставка OR currency OR FX|semiconductor OR electronics shortage
# News scheduler (do not enable in root .env for competition stands — use
# data/competition_stand/real_news_613/news_scheduler.env instead).
# NEWS_SCHEDULER_INTERVAL_SECONDS=1200
# NEWS_SCHEDULER_STATE_DIR=data/news_scheduler
# NEWS_SCHEDULER_PENDING_LIMIT=100
# NEWS_SCHEDULER_HTTP_TIMEOUT_SECONDS=20

# Competition case block on GET /companies/{id}/context (server-only slot).
# Leave empty to keep case_context.status=integration_not_configured.
# Does not import, link, or activate data. Do not accept slot from the client.
# CASE_CONTEXT_SLOT_KEY=competition_default

# Company registry lookup by INN (POST /company-registry/lookup + /confirm).
# Real source: DaData findById/party (public ЕГРЮЛ/ЕГРИП data via intermediary —
# NOT a direct FNS request). Backend-only secret: never put it in web/.env / VITE_*.
# Empty key → endpoint returns status=not_configured and the UI keeps manual entry
# working (no demo/fake answer is substituted). DaData does not promise a free tier —
# check your plan's limits before relying on it.
DADATA_API_KEY=
# Runtime knobs (optional). Rate limit / cache are PER PROCESS (see docs/COMPANY_INN_LOOKUP.md).
# COMPANY_REGISTRY_TIMEOUT_SECONDS=6.0
# COMPANY_REGISTRY_MAX_CANDIDATES=10
# COMPANY_REGISTRY_MAX_RESPONSE_BYTES=1000000
# COMPANY_REGISTRY_CACHE_TTL_SECONDS=3600
# COMPANY_REGISTRY_USER_RATE_PER_MINUTE=20
# COMPANY_REGISTRY_LOOKUP_TTL_SECONDS=900

# Bank materials read-only API (GET /bank-materials/...).
# Empty ALLOWED OCR run IDs → BANK_MATERIALS_NOT_CONFIGURED (no auto-open of corpus).
# Client cannot expand scope via run/document/file IDs. Comma- or pipe-separated.
# BANK_MATERIALS_ALLOWED_OCR_RUN_IDS=
# Directory that confines storage_key resolution for PDF download (no StaticFiles).
# BANK_MATERIALS_STORAGE_ROOT=data/bank_materials/storage
